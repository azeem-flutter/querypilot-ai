# --- Database (restricted role only) ---
DATABASE_URL=postgresql://query_readonly:replace_me@host:5432/postgres
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_MAX_ROWS=100

# --- LLM (Day 2) ---
# LLM_PROVIDER=fake -> bina API key ke dev/testing; groq -> asli provider
LLM_PROVIDER=groq
# Groq console ke Playground/Models page se model id copy karo
LLM_MODEL=replace_with_model_id
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
# Free tier mein tokens/minute kam hain, isliye 1500 se zyada mat rakho
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0
# json_object sab models par chalta hai; json_schema sirf supported models par
LLM_JSON_MODE=json_object
# Sirf reasoning models (gpt-oss) ke liye: low / medium / high. Normal model par is line ko hata do.
LLM_REASONING_EFFORT=low